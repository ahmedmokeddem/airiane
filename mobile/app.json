{
  "expo": {
    "name": "RE",
    "slug": "re-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.re.patient",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow RE voice conversations.",
        "NSCameraUsageDescription": "Allow local preview only. RE cannot see your video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.re.patient",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow a local camera preview. RE cannot see or store it.",
          "recordAudioAndroid": false
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow RE voice conversations.",
          "cameraPermission": "Allow local preview only."
        }
      ],
      "expo-router"
    ],
    "scheme": "re-patient"
  }
}
