# mock = explicit fictional offline backend and simulated agent tools
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:8000
# live backend development demo auth only; never enable backend demo auth in production
EXPO_PUBLIC_DEMO_AUTH=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# live voice requires backend agent bootstrap, verified provider privacy, and development build
EXPO_PUBLIC_VOICE_PROVIDER=simulated
